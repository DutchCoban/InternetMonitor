<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InternetMonitor</RootNamespace>
    <AssemblyName>InternetMonitor</AssemblyName>

    <ApplicationIcon>..\Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
    <Version>1.1.3</Version>
    <Product>Internet Monitor</Product>
    <Company>Internet Monitor</Company>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Only en/nl are ever loaded (see Localization/LocalizationManager.cs) - this stops the
         self-contained runtime from also bundling framework satellite resource assemblies for
         every other language, which otherwise ship unused. Safe for ordinary "dotnet build" too. -->
    <SatelliteResourceLanguages>en;nl</SatelliteResourceLanguages>

    <!-- Self-contained/single-file publish settings default to off here so an ordinary
         "dotnet build" stays framework-dependent and doesn't need win-x64 runtime packs
         restored. They are supplied on the command line for the actual publish (see
         README.md): self contained true, PublishSingleFile true, EnableCompressionInSingleFile
         true. That is the officially supported way to scope these to publish only.
         Deliberately NOT using PublishReadyToRun: it roughly doubles the size of framework
         assemblies by embedding precompiled native code for faster cold start, which isn't worth
         the trade-off for a tray app that starts once and runs for days. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded (not Content) so these ship inside the single-file publish exe rather than
         as loose files alongside it. -->
    <EmbeddedResource Include="Localization\nl.json" LogicalName="InternetMonitor.Localization.nl.json" />
    <EmbeddedResource Include="Localization\en.json" LogicalName="InternetMonitor.Localization.en.json" />
    <EmbeddedResource Include="..\Assets\app.ico" LogicalName="InternetMonitor.Assets.app.ico" />
  </ItemGroup>

</Project>
