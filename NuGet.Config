<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The machine-wide NuGet.Config has no package sources configured, which blocks
       restoring the win-x64 self-contained runtime packs needed to publish. This file
       scopes nuget.org to this project only, without touching the global user config. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
