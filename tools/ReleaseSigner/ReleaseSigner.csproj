<Project Sdk="Microsoft.NET.Sdk">

  <!-- Maintainer tool, never shipped: makes the release signing key pair, signs a published
       InternetMonitor.exe so the app's self-update can verify what it downloaded (see
       src/InternetMonitor/Core/Updates/ReleaseSignature.cs), and has VirusTotal check the
       executable before it is published. Plain .NET, no packages. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InternetMonitor.Tools.ReleaseSigner</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
